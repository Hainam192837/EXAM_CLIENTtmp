{
  "name": "exam_client",
  "description": "Exam client desktop application built with Vue and Electron",
  "main": "electron/main.js",
  "private": true,
  "version": "1.0.2",
  "homepage": "https://example.com/exam-client",
  "author": {
    "name": "TMath Team",
    "email": "dev@tmath.local"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:icons",
    "build": "vue-tsc -b && vite build",
    "generate:icons": "mkdir -p electron/icons && icon-gen -i electron/logo.png -o electron/icons --ico --icns --ico-name app --icns-name app",
    "preview": "vite preview",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently -k -n VITE,ELECTRON \"npm:dev\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.js\"",
    "electron:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "electron:win": "npm run build && electron-builder --win portable zip --x64",
    "electron:mac": "npm run build && electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@tailwindcss/vite": "^4.2.1",
    "electron-updater": "^6.8.3",
    "katex": "^0.16.38",
    "lucide-vue-next": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.25",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "electron-builder": "^25.1.8",
    "icon-gen": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^8.0.5",
    "vue-tsc": "^3.1.5"
  },
  "build": {
    "appId": "com.tmath.examclient",
    "productName": "Exam Client",
    "artifactName": "Exam-Client-${version}-${arch}.${ext}",
    "icon": "electron/logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.js",
      "package.json"
    ],
    
    "linux": {
      "icon": "electron/logo.png",
      "maintainer": "TMath Team <dev@tmath.local>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "mac": {
      "icon": "electron/icons/app.icns"
    },
    "win": {
      "icon": "electron/icons/app.ico",
      "target": [
        "portable",
        "zip"
      ]
    }
  }
}
